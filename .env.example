# Copy this file to .env and fill in your values
# cp .env.example .env

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=novel_db
DB_USER=novel_user
DB_PASS=change_me_password

# Shared download directories (relative to project root)
PENDING_DIR=data/downloads/pending
PROCESSING_DIR=data/downloads/processing
DONE_DIR=data/downloads/done
FAILED_DIR=data/downloads/failed

# Crawler settings
CRAWLER_CONCURRENCY=2
# Min/max random delay between requests (milliseconds). Each request waits a
# random duration in [CRAWLER_REQUEST_INTERVAL_MS, CRAWLER_REQUEST_INTERVAL_MAX_MS]
# to simulate human browsing behaviour and reduce the chance of IP bans.
CRAWLER_REQUEST_INTERVAL_MS=3000
CRAWLER_REQUEST_INTERVAL_MAX_MS=10000

# Optional HTTP/HTTPS proxy for the crawler (leave blank to disable).
# Formats: http://host:port  or  http://user:pass@host:port
CRAWLER_PROXY=

# SQLite task-deduplication DB path (crawler)
SQLITE_PATH=data/crawler_tasks.db

# Parser log level (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO

# Watcher polling interval in seconds (parser)
WATCHER_POLL_INTERVAL=5
